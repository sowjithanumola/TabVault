rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection probe document
    match /test/connection {
      allow read: if true;
    }

    // Common security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == userId
        && incoming().email is string
        && incoming().email.size() <= 256;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email;
      allow delete: if isOwner(userId);

      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(bookmarkId)
          && incoming().userId == userId
          && incoming().id is string
          && incoming().id.size() <= 128
          && incoming().url is string
          && incoming().url.size() <= 2048
          && incoming().title is string
          && incoming().title.size() <= 256;
        allow update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().url is string
          && incoming().url.size() <= 2048
          && incoming().title is string
          && incoming().title.size() <= 256;
        allow delete: if isOwner(userId);
      }

      // Collections subcollection
      match /collections/{collectionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(collectionId)
          && incoming().userId == userId
          && incoming().id is string
          && incoming().id.size() <= 128
          && incoming().name is string
          && incoming().name.size() <= 128;
        allow update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().name is string
          && incoming().name.size() <= 128;
        allow delete: if isOwner(userId);
      }
    }
  }
}
